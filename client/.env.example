# Public values are embedded during the client build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM=
# reCAPTCHA v2 checkbox site key; pair with RECAPTCHA_ENABLED on the API.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only proxy destination, read at runtime by the same-origin API proxy.
API_INTERNAL_URL=http://127.0.0.1:4000

# File storage origin for Next Image. Match the environment's Convex deployment.
CONVEX_CLOUD_URL=https://acrobatic-rooster-902.eu-west-1.convex.cloud

# Same server-only value as API_PROXY_SECRET in the Express project.
API_PROXY_SECRET=
