{
  "openapi": "3.1.0",
  "info": {
    "title": "Portfolio API",
    "version": "0.3.0",
    "description": "All browser routes live in Express. Admin cookie authentication ships in phase 5; no public editor bypass. All content responses use Cache-Control: no-store. See phase-3-api.md for setup, response wrappers, request examples and freshness."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "paths": {
    "/api/content": {
      "get": {
        "summary": "Published, visible groups. Without explicit pagination, all entries are returned. Unknown category: 422; known empty category: items=[]. Singleton groups contain at most one item.",
        "security": [],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Administrator session required (all custom-admin access is denied until phase 5)."
          },
          "422": {
            "description": "Invalid final document; no content write occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "CMS unavailable or read credential not configured."
          }
        }
      }
    },
