  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portfolio_session",
        "description": "Reserved phase-5 session scheme; currently every production admin request is denied."
      }
    },
    "schemas": {
      "hero": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "paragraph": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1
          },
          "greeting": {
            "type": "string",
            "maxLength": 500
          },
          "role": {
            "type": "string",
            "maxLength": 500
          },
          "availability": {
            "type": "string",
            "maxLength": 500
          },
          "eyebrow": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "buttons": {
            "type": "array",
            "minItems": 0,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "url"
              ]
            }
          },
          "panels": {
            "type": "array",
            "minItems": 0,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tokens": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 200,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "text": {
                              "type": "string",
                              "maxLength": 5000
                            },
                            "tone": {
                              "type": "string",
                              "enum": [
                                "default",
                                "muted",
                                "green",
                                "cyan",
                                "orange",
                                "purple",
                                "white"
                              ]
                            }
                          },
                          "required": []
                        }
                      }
                    },
                    "required": [
                      "tokens"
                    ]
                  }
                }
              },
              "required": [
                "title",
                "lines"
              ]
            }
          }
        },
        "required": [
          "heading",
          "paragraph"
        ],
        "description": "Hero, singleton. Required text is trimmed/non-empty. "
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "company": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "image": {
            "description": "Existing upload ID (image). Pending/missing uploads are rejected.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "current": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "durationLabel": {
            "type": "string",
            "maxLength": 500
          },
          "highlights": {
            "type": "array",
            "minItems": 0,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 5000,
                  "minLength": 1
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "title",
          "company",
          "image",
          "description",
          "startDate",
          "current"
        ],
        "description": "Experience, multiple. Required text is trimmed/non-empty. current=true requires an empty endDate; current=false requires endDate >= startDate."
      },
      "projects": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1
          },
          "role": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "projectStatus": {
            "type": "string",
            "enum": [
              "Live",
              "Completed",
              "In progress"
            ]
          },
          "gallery": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "description": "Existing upload ID (image). Pending/missing uploads are rejected.",
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                },
                "alt": {
                  "type": "string",
                  "maxLength": 300,
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "image",
                "alt"
              ]
            }
          },
          "technologies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 5000,
                  "minLength": 1
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "details": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 5000,
                  "minLength": 1
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "imageKind": {
            "type": "string",
            "enum": [
              "logo",
              "screenshot"
            ]
          },
          "sourceUrl": {
            "type": "string"
          },
          "demoUrl": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug",
          "description",
          "outcome",
          "role",
          "projectStatus",
          "gallery",
          "technologies",
          "details"
        ],
        "description": "Projects, multiple. Required text is trimmed/non-empty. "
      },
      "skills": {
