    "/api/admin/content": {
      "get": {
        "summary": "List draft content by default; status=published supported",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string"
            }
