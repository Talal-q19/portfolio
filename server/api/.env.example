PORT=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Defaults to SMTP_USER when empty. Multiple recipients may be comma-separated.
CONTACT_TO_EMAIL=
CONTACT_FROM_NAME=Portfolio Contact
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
# Optional expected hostname returned by Google, e.g. portfolio.example.com
RECAPTCHA_EXPECTED_HOSTNAME=
CONTACT_RATE_LIMIT=5
# Omit for direct access. Set only for a fixed trusted proxy topology.
# TRUST_PROXY_HOPS=1

# Phase 3 content API (server-only; never prefix the credential with NEXT_PUBLIC_)
CMS_INTERNAL_URL=http://127.0.0.1:1337
CMS_READ_TOKEN=
CMS_TIMEOUT_MS=10000

# Phase 4 local editing, provisioned by npm run setup:admin (never enable in production).
LOCAL_ADMIN_ENABLED=false
CMS_LOCAL_ADMIN_TOKEN=

# Admin authentication (PostgreSQL database already exists)
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/portfolio
REDIS_URL=redis://127.0.0.1:6379
AUTH_JWT_SECRET=
ADMIN_ORIGIN=http://localhost:3000
# Server-to-server CMS credential. Never sent to the browser.
CMS_ADMIN_TOKEN=
# Used only by npm run admin:create; remove ADMIN_PASSWORD after provisioning.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
