PORT=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Defaults to SMTP_USER when empty. Multiple recipients may be comma-separated.
CONTACT_TO_EMAIL=
CONTACT_FROM_NAME=Portfolio Contact
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
# Optional expected hostname returned by Google, e.g. portfolio.example.com
RECAPTCHA_EXPECTED_HOSTNAME=
CONTACT_RATE_LIMIT=5
# Omit for direct access. Set only for a fixed trusted proxy topology.
# TRUST_PROXY_HOPS=1

# Convex HTTP actions endpoint. Use your development deployment locally.
CONVEX_HTTP_URL=https://acrobatic-rooster-902.eu-west-1.convex.site
CONVEX_SERVICE_SECRET=
# CLI/build only; never exposed to browsers or sent to the bridge.
CONVEX_DEPLOY_KEY=
AUTH_JWT_SECRET=
ADMIN_ORIGIN=http://localhost:3000
# Operator commands only. Remove ADMIN_PASSWORD after account creation.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared frontend/backend signed proxy secret (at least 32 random bytes).
API_PROXY_SECRET=
