{
  "name": "portfolio-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/app.js && node --check src/index.js",
    "admin:create": "node scripts/admin.js create",
    "admin:block": "node scripts/admin.js block",
    "admin:unblock": "node scripts/admin.js unblock",
    "test:convex": "vitest run",
    "build:vercel": "node scripts/vercel-build.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "migration:export": "node scripts/export-legacy.js",
    "migration:import": "node scripts/import-convex.js"
  },
  "dependencies": {
    "@portfolio/content-contract": "file:../content-contract",
    "convex": "^1.48.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.67",
    "pg": "^8.23.1",
    "smtp-server": "^3.16.1",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
