HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
# Generate local secrets using npm run setup:local. Never reuse in production.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Production: DATABASE_CLIENT=postgres, plus a separate production database URL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
UPLOAD_PROVIDER=local
# Set only on Strapi Cloud with its included persistent media storage.
STRAPI_CLOUD=false
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
